# PayPal sandbox app (developer.paypal.com). Leave empty to run the arena on the labelled stand-in.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com

# The model at both doors. Any OpenAI-compatible endpoint works.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.tokenfactory.nebius.com/v1
MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Only for the benchmark, if you run Anthropic models through it.
ANTHROPIC_API_KEY=

PUBLIC_URL=

# Arena settings (all optional)
DEFAULT_PROMPT=shop          # which instructions the arena starts on: bare, shop or strict
MAX_MESSAGES_PER_DAY=3000    # whole-site daily limit, so nobody can burn the model budget
CHECK_DISPUTES=0             # set to 1 only after you have seen getOpenDispute work on the sandbox
USE_TOOLKIT=1                # set to 0 to switch PayPal's Agent Toolkit off and use plain REST
TEMPERATURE=0                # the benchmark sets its own
