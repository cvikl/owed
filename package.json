{
  "name": "owed-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "bench": "node --env-file-if-exists=.env scripts/bench.js",
    "bench:mock": "node scripts/bench.js --mock",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "race": "node --env-file-if-exists=.env scripts/race-live.js",
    "bench:dial": "PROMPTS=shop,strict RUNS=1 TEMPERATURE=0 node --env-file-if-exists=.env scripts/bench.js",
    "bench:smoke": "LIMIT=5 PROMPTS=bare,shop,strict BENCH_TAG=smoke node --env-file-if-exists=.env scripts/bench.js",
    "bench:bare": "PROMPTS=bare RUNS=1 TEMPERATURE=0 BENCH_TAG=bare node --env-file-if-exists=.env scripts/bench.js"
  },
  "engines": {
    "node": ">=22"
  }
}
